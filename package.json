    "enrich:tmdb": "tsx scripts/enrich/tmdb.mts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "playwright": "^1.65.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
