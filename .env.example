# Copy to .env and fill in. Never commit .env.
# --- Postgres (docker compose) ---
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taipei_movies
POSTGRES_PORT=5432

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050

# --- App ---
DATABASE_URL=postgres://changeme:changeme@localhost:5432/taipei_movies
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Production web (docker compose web service) ---
WEB_PORT=3000
# Cloudflare Tunnel token (optional, profile "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
