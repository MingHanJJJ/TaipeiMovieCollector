// Phase 0 spike (read-only): GET the public SessionSeats page for ONE session and save it.
import { chromium } from "playwright-extra";
import stealth from "puppeteer-extra-plugin-stealth";
import { writeFileSync, mkdirSync } from "node:fs";
import { join } from "node:path";
const OUT = process.argv[2]; const SESSION = process.argv[3]; mkdirSync(OUT, { recursive: true });
chromium.use(stealth());
const browser = await chromium.launch({ headless: true });
const ctx = await browser.newContext({ locale: "zh-TW", viewport: { width: 1280, height: 1000 } });
const page = await ctx.newPage();
const log: string[] = [];
page.on("response", (r) => { const t = r.request().resourceType(); if (["document","xhr","fetch"].includes(t) && !/google|mpulse|analytics/.test(r.url())) log.push(`${r.status()} ${r.request().method()} ${t} ${r.url()}`); });
const url = `https://sales.vscinemas.com.tw/VoucherTicketing/SessionSeats.aspx?CinemaCode=1&txtSessionId=${SESSION}`;
const r = await page.goto(url, { timeout: 45000 });
await page.waitForTimeout(3000);
console.log("status", r?.status(), "url", page.url(), "title", await page.title());
console.log("body:", (await page.innerText("body").catch(() => "")).replace(/\s+/g, " ").slice(0, 500));
writeFileSync(join(OUT, `seats-${SESSION}.html`), await page.content());
await page.screenshot({ path: join(OUT, `seats-${SESSION}.png`), fullPage: true });
console.log(log.join("\n"));
await browser.close();
