// Phase 0 spike (read-only): open a movie page, click ONE session's seat icon like a user, save the popup.
import { chromium } from "playwright-extra";
import stealth from "puppeteer-extra-plugin-stealth";
import { writeFileSync, mkdirSync } from "node:fs";
import { join } from "node:path";
const OUT = process.argv[2]; const MOVIE_URL = process.argv[3]; mkdirSync(OUT, { recursive: true });
chromium.use(stealth());
const browser = await chromium.launch({ headless: true });
const ctx = await browser.newContext({ locale: "zh-TW", viewport: { width: 1280, height: 1000 } });
const page = await ctx.newPage();
const log: string[] = [];
ctx.on("response", (r) => { const t = r.request().resourceType(); if (["document","xhr","fetch"].includes(t) && !/google|mpulse|analytics/.test(r.url())) log.push(`${r.status()} ${r.request().method()} ${t} ${r.url()}`); });
await page.goto(MOVIE_URL, { timeout: 45000 });
await page.waitForTimeout(3000);
const seatLinks = await page.$$eval('a[href*="SessionSeats"]', (as) => as.map((a) => (a as HTMLAnchorElement).href));
console.log("seat links:", seatLinks.length, seatLinks[0]);
const [popup] = await Promise.all([ctx.waitForEvent("page", { timeout: 15000 }), page.locator('a[href*="SessionSeats"]').first().click()]);
await popup.waitForLoadState("domcontentloaded");
await popup.waitForTimeout(4000);
console.log("popup url:", popup.url(), "title:", await popup.title());
console.log("body:", (await popup.innerText("body").catch(() => "")).replace(/\s+/g, " ").slice(0, 400));
writeFileSync(join(OUT, "seats-click.html"), await popup.content());
await popup.screenshot({ path: join(OUT, "seats-click.png"), fullPage: true });
console.log(log.slice(-8).join("\n"));
await browser.close();
